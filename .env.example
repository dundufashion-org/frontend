# Base URL of the Dundu backend (no trailing slash).
# Local: the Express server from ../backend (npm run dev → port 4000).
# Vercel: set this in Project → Settings → Environment Variables to your
# Railway domain, e.g. https://backend-production-xxxx.up.railway.app,
# then redeploy — the value is inlined at build time.
NEXT_PUBLIC_API_URL=http://localhost:4000
